# 服务端管理后台密码（必填，不会打包进前端）
ADMIN_PASSWORD=replace_with_a_long_random_password
# 建议设置固定随机值，使重启后的会话仍有效
SESSION_SECRET=replace_with_another_long_random_value

# 本地后端端口，与 Vite 代理配置一致
SERVER_PORT=3002

# AI 学习：只由服务端读取，后台不能查看或修改密钥与模型。
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# 访客注册验证码：站长的 QQ 邮箱（不是访客邮箱）
QQ_SMTP_USER=your_qq_number@qq.com
# QQ 邮箱开启 POP3/IMAP/SMTP 服务后生成的 16 位授权码，不是 QQ 登录密码
QQ_SMTP_AUTH_CODE=replace_with_your_qq_mail_authorization_code

# 订阅邮件中的网站地址：生产部署填写实际公开网址；开发填写当前 Vite 的地址和端口
PUBLIC_SITE_URL=http://localhost:5174
